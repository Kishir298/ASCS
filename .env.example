# Copy this file to `.env` and adjust, OR export these as real environment
# variables. All values shown are the repo defaults.

# Ollama connection (used by the ASCS native client and reflected in the CLI).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Per-request budget (seconds).
AGENT_REQUEST_TIMEOUT=600

# Keep the model warm in memory (e.g. "30m"). Empty uses Ollama's default.
AGENT_KEEP_ALIVE=30m

# Experience / learning memory: ASCS records verified outcomes to a local
# JSONL store and reuses past wins (and avoids repeated failures) on later runs.
# The CLI turns this on by default; set AGENT_EXPERIENCE_ENABLED=false to opt out.
AGENT_EXPERIENCE_ENABLED=true
# Default store when empty: ~/.risa/ascs/experiences.jsonl
AGENT_EXPERIENCE_PATH=

# Preload the model before the first real step.
AGENT_PREWARM=true

# Qwen3 generation knobs - sent ONLY to the native Ollama /api/chat options,
# never to an OpenAI-compatible endpoint.
AGENT_NUM_CTX=32768
AGENT_NUM_PREDICT=8192

# Intelligence tier: low | medium | high | xhigh | default
# Controls num_ctx/num_predict/context_budget/retrieve depth together.
# AGENT_NUM_CTX / AGENT_NUM_PREDICT above win if set explicitly.
AGENT_INTELLIGENCE=default

# Provider and model selection (TUI: /models /connect)
# Provider: ollama | openai | anthropic | grok | google | deepseek
# All providers are Ollama-compatible (fallback to Ollama if unavailable).
AGENT_PROVIDER=ollama
# AGENT_THEME: auto | light | dark (auto detects from terminal)
AGENT_THEME=auto

# Cloud provider API keys (or set via /connect in the TUI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# Provider base URLs (override if you use a proxy)
# OLLAMA_BASE_URL already above; for cloud you can set per-provider via TUI state
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Persisted TUI state (overridable for testing)
# AGENT_TUI_STATE_PATH=

# Ollama client retry policy (retries past the initial attempt).
AGENT_MAX_RETRIES=2
AGENT_BACKOFF_S=2.0

# Runtime (optional, see README for the full table).
AGENT_MODE=AUTO
AGENT_MAX_ITERATIONS=50
AGENT_MAX_OUTPUT_CHARS=20000

# Live integration tests are opt-in and require a running Ollama + qwen3:14b.
# Set to 1 only when you explicitly want the live suite.
# RISALIVE=0
